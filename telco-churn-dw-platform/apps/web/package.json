{
  "name": "telco-churn-pwa",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "sync-contracts": "node scripts/sync-contracts.mjs && node scripts/compile-validators.mjs",
    "icons": "node scripts/make-icons.mjs",
    "predev": "npm run sync-contracts",
    "dev": "next dev -p 3000",
    "prebuild": "npm run sync-contracts && npm run icons",
    "build": "next build",
    "postbuild": "node scripts/csp-hashes.mjs out nginx/csp-hashes.txt",
    "pretest": "npm run sync-contracts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests"
  },
  "dependencies": {
    "@serwist/next": "9.5.13",
    "@tanstack/react-table": "8.21.3",
    "ajv": "8.20.0",
    "bcryptjs": "3.0.3",
    "dexie": "4.4.6",
    "echarts": "5.6.0",
    "jose": "6.2.13",
    "mysql2": "3.24.6",
    "next": "15.5.27",
    "papaparse": "5.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "fake-indexeddb": "6.2.5",
    "jsdom": "26.1.0",
    "prettier": "3.9.9",
    "serwist": "9.5.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
