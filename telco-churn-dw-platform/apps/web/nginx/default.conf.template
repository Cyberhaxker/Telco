# Rendered at container start (envsubst) into /tmp/conf.d/default.conf.
server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  client_max_body_size 12m;

  set $csp "default-src 'self'; script-src 'self' __CSP_SCRIPT_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' ${PUBLIC_KEYCLOAK_URL}; frame-src 'self' ${PUBLIC_KEYCLOAK_URL}; frame-ancestors 'none'; worker-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self' ${PUBLIC_KEYCLOAK_URL}; object-src 'none'";

  add_header Content-Security-Policy $csp always;
  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;
  add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()" always;
  add_header Cross-Origin-Opener-Policy same-origin always;

  location = /nginx-health { access_log off; default_type text/plain; return 200 "ok\n"; }

  # API traffic goes through the gateway (OIDC, rate limits, CORS) on the same origin.
  location /api/ {
    proxy_pass http://${GATEWAY_UPSTREAM};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_read_timeout 130s;
    proxy_buffering off;
  }

  location = /config.json {
    alias /tmp/config/config.json;
    default_type application/json;
    add_header Cache-Control "no-store" always;
    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options nosniff always;
  }

  location = /sw.js {
    add_header Cache-Control "no-cache" always;
    add_header Service-Worker-Allowed "/" always;
    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options nosniff always;
  }

  location /_next/static/ {
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header X-Content-Type-Options nosniff always;
  }

  location /icons/ {
    add_header Cache-Control "public, max-age=604800" always;
  }

  location / {
    add_header Cache-Control "no-cache" always;
    add_header Content-Security-Policy $csp always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    try_files $uri $uri.html $uri/index.html =404;
  }

  error_page 404 /404.html;
}
