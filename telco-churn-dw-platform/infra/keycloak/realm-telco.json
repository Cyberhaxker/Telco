{
  "realm": "telco",
  "displayName": "Telco Churn Analytics",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(10) and notUsername",
  "defaultSignatureAlgorithm": "RS256",
  "roles": {
    "realm": [
      {
        "name": "admin",
        "description": "Manage users, metadata, pipelines and models",
        "composite": true,
        "composites": {
          "realm": [
            "data_steward",
            "data_entry",
            "analyst",
            "viewer"
          ]
        }
      },
      {
        "name": "data_steward",
        "description": "Manage metadata and data dictionary, review rejected batches",
        "composite": true,
        "composites": {
          "realm": [
            "analyst",
            "viewer"
          ]
        }
      },
      {
        "name": "data_entry",
        "description": "Create/update operational records and submit batches",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "analyst",
        "description": "Read OLAP analytics and predictions",
        "composite": true,
        "composites": {
          "realm": [
            "viewer"
          ]
        }
      },
      {
        "name": "viewer",
        "description": "Read dashboards only"
      }
    ]
  },
  "clients": [
    {
      "clientId": "telco-api",
      "name": "Telco APIs (audience)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "telco-pwa",
      "name": "Telco Churn PWA",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "${PUBLIC_WEB_URL}",
      "baseUrl": "/",
      "redirectUris": [
        "${PUBLIC_WEB_URL}/*"
      ],
      "webOrigins": [
        "${PUBLIC_WEB_URL}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${PUBLIC_WEB_URL}/*",
        "use.refresh.tokens": "true"
      },
      "optionalClientScopes": [
        "offline_access"
      ],
      "protocolMappers": [
        {
          "name": "telco-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "telco-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "${KC_GATEWAY_CLIENT_ID}",
      "name": "APISIX gateway",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KC_GATEWAY_CLIENT_SECRET}",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "telco-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "telco-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "telco-cli",
      "name": "CLI / automated tests (DEV ONLY - disable in production)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "telco-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "telco-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@telco.local",
      "emailVerified": true,
      "firstName": "Ada",
      "lastName": "Admin",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "steward",
      "enabled": true,
      "email": "steward@telco.local",
      "emailVerified": true,
      "firstName": "Sam",
      "lastName": "Steward",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "data_steward"
      ]
    },
    {
      "username": "entry",
      "enabled": true,
      "email": "entry@telco.local",
      "emailVerified": true,
      "firstName": "Eli",
      "lastName": "Entry",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "data_entry"
      ]
    },
    {
      "username": "analyst",
      "enabled": true,
      "email": "analyst@telco.local",
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Analyst",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "analyst"
      ]
    },
    {
      "username": "viewer",
      "enabled": true,
      "email": "viewer@telco.local",
      "emailVerified": true,
      "firstName": "Vic",
      "lastName": "Viewer",
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_USER_PASSWORD}",
          "temporary": false
        }
      ],
      "realmRoles": [
        "viewer"
      ]
    }
  ]
}