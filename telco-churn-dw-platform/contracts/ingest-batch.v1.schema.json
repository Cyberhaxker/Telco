{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://telco.local/contracts/ingest-batch.v1.schema.json",
  "title": "IngestBatch",
  "description": "Body of POST /api/v1/ingest/batches. Headers: Idempotency-Key (UUID) and X-Checksum-SHA256 (hex SHA-256 of the exact request body bytes).",
  "type": "object",
  "additionalProperties": false,
  "required": ["batch_id", "client_id", "created_at", "records"],
  "properties": {
    "batch_id":   { "type": "string", "format": "uuid" },
    "client_id":  { "type": "string", "minLength": 1, "maxLength": 64 },
    "created_at": { "type": "string", "format": "date-time" },
    "source":     { "enum": ["form", "csv"], "default": "form" },
    "records":    { "type": "array", "minItems": 1, "maxItems": 500, "items": { "$ref": "telco-record.v1.schema.json" } }
  }
}
