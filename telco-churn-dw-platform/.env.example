# -----------------------------------------------------------------------------
# Telco Churn Analytics Platform - environment template
# Copy to .env (`make env`) and change every value marked CHANGE_ME before
# exposing the stack anywhere other than localhost. .env is git-ignored.
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=telco
ENVIRONMENT=dev
LOG_LEVEL=INFO

# ---- Public URLs (what the browser sees) -----------------------------------
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_GATEWAY_URL=http://localhost:9080
PUBLIC_KEYCLOAK_URL=http://localhost:8081

# ---- Host port mappings (change if a port is already taken on your machine) -
WEB_PORT=3000
APISIX_PORT=9080
KEYCLOAK_PORT=8081
AIRFLOW_PORT=8082
MLFLOW_PORT=5000
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
POSTGRES_PORT=5432
MYSQL_PORT=3306
KAFKA_PORT=9092

# ---- PostgreSQL data warehouse ---------------------------------------------
DW_DB=telco_churn_dw
DW_SUPERUSER=postgres
DW_SUPERUSER_PASSWORD=CHANGE_ME_dw_super
# Least-privilege service roles (created by infra/db/postgres/init)
DW_OWNER_PASSWORD=CHANGE_ME_dw_owner          # dbt + Airflow (DDL in raw/staging/marts/olap)
DW_INGEST_PASSWORD=CHANGE_ME_dw_ingest        # stream-consumer (INSERT into raw)
DW_ANALYTICS_PASSWORD=CHANGE_ME_dw_analytics  # analytics-api (read-only)
DW_META_PASSWORD=CHANGE_ME_dw_meta            # metadata-api (rw meta, read marts)
DW_ML_PASSWORD=CHANGE_ME_dw_ml                # ml training/scoring (rw ml, update fact)
DW_MONITOR_PASSWORD=CHANGE_ME_dw_monitor      # postgres-exporter (pg_monitor, no data access)
ML_PREDICTION_RETENTION_DAYS=400

# ---- Platform PostgreSQL (Airflow, Keycloak, MLflow metadata) ---------------
PLATFORM_DB_PASSWORD=CHANGE_ME_platform

# ---- MySQL operational database ---------------------------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_mysql_root
OPS_DB=telco_ops
OPS_APP_PASSWORD=CHANGE_ME_ops_app            # ingestion-api (rw)
OPS_EXTRACT_PASSWORD=CHANGE_ME_ops_extract    # Airflow extract (read-only)
OPS_MONITOR_PASSWORD=CHANGE_ME_ops_monitor    # mysqld-exporter (PROCESS, REPLICATION CLIENT)

# ---- Kafka -----------------------------------------------------------------
KAFKA_CLUSTER_ID=5L6g3nShT-eMCtK--X86sw

# ---- Keycloak --------------------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_kc_admin
KEYCLOAK_REALM=telco
KEYCLOAK_PWA_CLIENT_ID=telco-pwa
KEYCLOAK_GATEWAY_CLIENT_ID=telco-gateway
KEYCLOAK_GATEWAY_CLIENT_SECRET=CHANGE_ME_gateway_secret
# Password for the five demo users (admin, steward, entry, analyst, viewer)
DEMO_USER_PASSWORD=CHANGE_ME_demo

# ---- Valkey ----------------------------------------------------------------
VALKEY_PASSWORD=CHANGE_ME_valkey

# ---- Airflow ---------------------------------------------------------------
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_airflow
AIRFLOW_FERNET_KEY=
AIRFLOW_JWT_SECRET=CHANGE_ME_airflow_jwt_secret_32chars_min
AIRFLOW_ALERT_WEBHOOK_URL=
AIRFLOW_ALERT_EMAIL=

# ---- MLflow / ML -----------------------------------------------------------
MLFLOW_TRACKING_URI=http://mlflow:5000
ML_MODEL_NAME=telco_churn
ML_CHAMPION_METRIC=f1
ML_MIN_ROC_AUC=0.83
ML_HIGH_RISK_THRESHOLD=0.6

# ---- Grafana ---------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_grafana

# ---- Production only (docker-compose.prod.yml) -------------------------------
# PUBLIC_DOMAIN=telco.example.com
# PUBLIC_WEB_URL=https://telco.example.com
# PUBLIC_GATEWAY_URL=https://telco.example.com
# PUBLIC_KEYCLOAK_URL=https://telco.example.com/auth
# Put fullchain.pem / privkey.pem in infra/nginx/certs/ (git-ignored).
